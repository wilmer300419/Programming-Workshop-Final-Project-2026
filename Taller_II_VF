import tkinter as tk
from tkinter import messagebox

N = 8
R = 15
PAD = 12

ventana = tk.Tk()
ventana.title("cuadricula de circulos")

lado = N * (2 * R + PAD) + PAD
lienzo = tk.Canvas(ventana, width=lado, height=lado, bg="white")
lienzo.grid(row=0, column=0, columnspan=3)

circulos ={}
seleccionados = []

for y in range (1, N+1):
    for x in range (1, N +1):
        cx= PAD + (x-1) * (2 * R + PAD) + R
        cy= PAD + (y-1) * (2 * R + PAD) + R
        circulos[(x,y)] = lienzo.create_oval(cx - R, cy - R, cx + R, cy + R, fill="", outline="black")

def seleccionar():
    try:
        x = int(entrada_x.get())
        y = int(entrada_y.get())
    except ValueError:
        messagebox.showerror("Error", "Ingrese números enteros")
        return
    if 1 <= x <= N and 1 <= y <= N:
        lienzo.itemconfig(circulos[(x,y)], fill="black")
        if (x,y) not in seleccionados:
            seleccionados.append((x,y))
            etiqueta.config(text="Seleccionadas: " + str(seleccionados))
        else:
            messagebox.showwarning("Coordenada no admitida", "Los valores deben estar entre 1 y " + str(N) + ".")


def reiniciar():
    for id_circulo in circulos.values():
        lienzo.itemconfig(id_circulo, fill="")
seleccionados.clear()
etiqueta.config(text="Seleccionadas:[]")


tk.Label(ventana, text="X:").grid(row=1, column=0)
entrada_x = tk.Entry(ventana, width=5)
entrada_x.grid(row=1, column=1)
tk.Label(ventana, text="Y:").grid(row=2, column=0)
entrada_y = tk.Entry(ventana, width=5)
entrada_y.grid(row=2, column=1)


tk.Button(ventana, text= "Seleccionar", command= seleccionar).grid(row=1, column=2)
tk.Button(ventana, text= "Reiniciar", command=reiniciar).grid(row=2, colum=2)

etiqueta = tk.Label(ventana, text= "Seleccionadas:[]")
etiqueta.grid(row=3, column=0, columspan=3)

ventana.mainloop()
